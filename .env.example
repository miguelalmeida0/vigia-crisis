# VIGIA production runtime. TEST fixtures use test-only entrypoints and cannot be enabled here.
VIGIA_UNIVERSE=production

# NASA FIRMS point-level VIIRS detections.
NASA_FIRMS_MAP_KEY=
VIGIA_FIRMS_POLL_INTERVAL_MS=300000
VIGIA_FIRMS_MAX_BACKOFF_MS=1800000

# Structured MTG FCI FRP points. Configure a local product drop OR a normalized JSON gateway.
VIGIA_MTG_FRP_DIR=
VIGIA_MTG_FRP_JSON_URL=

# Structured Sentinel-3 SLSTR L2 NRT FRP. Configure a local product drop OR normalized JSON gateway.
VIGIA_SENTINEL3_FRP_DIR=
VIGIA_SENTINEL3_FRP_JSON_URL=

# Scientific raster runtime. Install workers/geospatial/requirements.txt in this interpreter.
VIGIA_GEO_PYTHON=python3

# Connected physical observation assets.
VIGIA_SENSOR_REGISTRY_FILE=./data/config/sensors.json
VIGIA_SENSOR_INGEST_TOKEN=
VIGIA_SENSOR_TASK_TOKEN=

# Optional sub-10 m optical provider for questions Sentinel-2 cannot resolve.
VIGIA_HIGHRES_STAC_URL=
VIGIA_HIGHRES_STAC_COLLECTION=
VIGIA_HIGHRES_STAC_TOKEN=
VIGIA_HIGHRES_STAC_ASSET_HOSTS=

# Optional separately validated fire-behaviour provider.
VIGIA_SPREAD_PROVIDER_URL=
VIGIA_SPREAD_PROVIDER_API_KEY=

# Persisted operational alert delivery.
VIGIA_ALERT_WEBHOOK_URL=
VIGIA_ALERT_STATE_FILE=./data/runtime/alerts-v10.json

HOST=127.0.0.1
PORT=4173
OPEN_BROWSER=0
REFRESH_MS=30000
REQUEST_TIMEOUT_MS=12000
VIGIA_STATE_FILE=./data/runtime/production-v1.json
VIGIA_ACQUISITION_STATE_FILE=./data/runtime/acquisition-state.json
VIGIA_RAW_ARCHIVE_DIR=./data/runtime/raw-source-products
# Transactional metadata/event/lineage plane. Local PostGIS compose listens on 55432.
VIGIA_DATABASE_URL=postgresql://vigia:vigia-local-only@127.0.0.1:55432/vigia
VIGIA_HISTORY_YEAR=2026
