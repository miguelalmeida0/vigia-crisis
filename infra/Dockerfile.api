FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436
WORKDIR /opt/vigia
ENV NODE_ENV=production OPEN_BROWSER=0
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY apps/api ./apps/api
COPY apps/field-node ./apps/field-node
COPY packages ./packages
COPY scripts ./scripts
COPY data/config ./data/config
COPY data/reference ./data/reference
COPY data/validation/release/current-release-manifest.json ./data/validation/release/current-release-manifest.json
COPY data/validation/release/release-source-manifest.json ./data/validation/release/release-source-manifest.json
COPY data/validation/release/release-statement.json ./data/validation/release/release-statement.json
COPY data/replay/corpus ./data/replay/corpus
COPY data/replay/results ./data/replay/results
COPY data/validation/detection/portugal-2023-v4-confirmatory-benchmark.json ./data/validation/detection/portugal-2023-v4-confirmatory-benchmark.json
COPY data/validation/detection/portugal-2024-small-fire-opportunity.json ./data/validation/detection/portugal-2024-small-fire-opportunity.json
COPY data/validation/detection/sentinel3-portugal-2024-product-manifest.json ./data/validation/detection/sentinel3-portugal-2024-product-manifest.json
COPY data/validation/physical-sensing/gold-specialist-handoff.json ./data/validation/physical-sensing/gold-specialist-handoff.json
COPY data/validation/prevention/portugal-sentinel2-review-corpus-v3.json ./data/validation/prevention/portugal-sentinel2-review-corpus-v3.json
COPY data/validation/prevention/portugal-sentinel2-expert-review-pack-v1.json ./data/validation/prevention/portugal-sentinel2-expert-review-pack-v1.json
COPY data/validation/prevention/portugal-sentinel2-expert-review-key-v1.json ./data/validation/prevention/portugal-sentinel2-expert-review-key-v1.json
COPY data/validation/prevention/consensus-topology-evaluation-v1.json ./data/validation/prevention/consensus-topology-evaluation-v1.json
COPY data/validation/measurement-debt ./data/validation/measurement-debt
COPY data/validation/fieldnet ./data/validation/fieldnet
COPY data/validation/pilot ./data/validation/pilot
ARG VIGIA_APPROVED_RELEASE_STATEMENT_SHA256
RUN test -n "$VIGIA_APPROVED_RELEASE_STATEMENT_SHA256" && node scripts/release/verify_deployment_source.mjs --profile api
RUN mkdir -p data/runtime/fieldnet data/validation && chown -R node:node data
USER node
EXPOSE 4177
CMD ["node", "apps/api/src/server.mjs"]
